FROM docker.litellm.ai/berriai/litellm:1.99.1

COPY litellm/proxy/proxy_server.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/proxy_server.py
COPY litellm/constants.py /app/.venv/lib/python3.13/site-packages/litellm/constants.py
COPY litellm/proxy/auth/auth_checks.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/auth_checks.py
COPY litellm/proxy/db/db_lookup_gate.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/db/db_lookup_gate.py
COPY litellm/proxy/db/spend_counter_reseed.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/db/spend_counter_reseed.py
COPY litellm/proxy/hooks/parallel_request_limiter_v3.py /app/.venv/lib/python3.13/site-packages/litellm/proxy/hooks/parallel_request_limiter_v3.py

RUN python -m py_compile \
    /app/.venv/lib/python3.13/site-packages/litellm/constants.py \
    /app/.venv/lib/python3.13/site-packages/litellm/proxy/proxy_server.py \
    /app/.venv/lib/python3.13/site-packages/litellm/proxy/auth/auth_checks.py \
    /app/.venv/lib/python3.13/site-packages/litellm/proxy/db/db_lookup_gate.py \
    /app/.venv/lib/python3.13/site-packages/litellm/proxy/db/spend_counter_reseed.py \
    /app/.venv/lib/python3.13/site-packages/litellm/proxy/hooks/parallel_request_limiter_v3.py
